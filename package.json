{
  "name": "sitey-yonetim",
  "version": "0.1.0",
  "private": true,
  "description": "Çok siteli site/apartman yönetim platformu",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @sy/db run generate",
    "db:migrate": "pnpm --filter @sy/db run migrate",
    "db:push": "pnpm --filter @sy/db run push",
    "db:seed": "pnpm --filter @sy/db run seed",
    "db:studio": "pnpm --filter @sy/db run studio",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:app-role": "pnpm --filter @sy/db run app-role"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}

# ----------------------------------------------------------------------------
# Ortam. docker compose bu dosyayı .env olarak okur: `cp .env.example .env`
# ----------------------------------------------------------------------------

NODE_ENV=development
TZ=Europe/Istanbul

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=sitey
POSTGRES_PASSWORD=sitey_dev_parola
POSTGRES_DB=sitey
POSTGRES_PORT=5432
# Konteyner içinden (api servisi) erişim:
DATABASE_URL=postgresql://sitey:sitey_dev_parola@postgres:5432/sitey?schema=public
# Host makineden (prisma studio, migrate) erişim:
DATABASE_URL_HOST=postgresql://sitey:sitey_dev_parola@localhost:5432/sitey?schema=public

# --- RLS (çok kiracılılığın 3. katmanı) — varsayılan kapalı ------------------
# Açmak için: (1) `APP_DB_PASSWORD=... pnpm db:app-role` ile uygulama rolünü
# oluşturun, (2) DATABASE_URL'i o role çevirin, (3) migration'lar tablo sahibi
# rolle çalışsın diye MIGRATE_DATABASE_URL'i sahip bağlantısı yapın.
# Sahip/süper kullanıcıyla DB_RLS=on kuralları sessizce etkisiz bırakır.
DB_RLS=off
# DATABASE_URL=postgresql://sitey_app:<parola>@postgres:5432/sitey?schema=public
# MIGRATE_DATABASE_URL=postgresql://sitey:sitey_dev_parola@postgres:5432/sitey?schema=public

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- API --------------------------------------------------------------------
API_PORT=3101
JWT_ACCESS_SECRET=degistir-bu-degeri-access
JWT_REFRESH_SECRET=degistir-bu-degeri-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3100
# Bildirimlerdeki bağlantılar (ödeme linki) için; boşsa CORS_ORIGIN kullanılır
PUBLIC_WEB_URL=

# --- Web --------------------------------------------------------------------
WEB_PORT=3100
# Tarayıcıdan erişilen adres:
NEXT_PUBLIC_API_URL=http://localhost:3101
# Sunucu tarafı render sırasında konteyner-içi adres:
API_INTERNAL_URL=http://api:3001

# --- Dosya deposu -----------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_PATH=/app/storage

# --- E-posta (tek gerçek entegrasyon) ---------------------------------------
# log  = konsola yazar (geliştirme)
# smtp = gerçek gönderim
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Site Yönetimi <noreply@example.com>"

# --- Mock sağlayıcılar (SMS / WhatsApp / Sesli / Ödeme) ---------------------
SMS_DRIVER=mock
WHATSAPP_DRIVER=mock
VOICE_DRIVER=mock
PAYMENT_DRIVER=mock

# --- Seed -------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@site.local
SEED_ADMIN_PASSWORD=Admin1234!
